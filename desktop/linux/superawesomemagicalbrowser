#!/bin/sh
# Starts SuperAwesomeMagical Browser: our build of Ladybird (with Bitwarden in the toolbar) with the
# SuperAwesomeMagical presets, in a profile of its own so it never mixes with plain Ladybird. Arguments are Ladybird's: URLs to open, --new-window and so on.
#
# The presets (desktop/edition/settings.json) are written only when the profile has no settings
# yet, so anything changed in Ladybird's Settings stays changed.
# (SAM_SHARE and SAM_LADYBIRD are for desktop/check.py, to try a build before it is installed.)
SHARE=${SAM_SHARE:-@SHARE@}
LADYBIRD=${SAM_LADYBIRD:-/usr/lib/superawesomemagicalbrowser/ladybird/bin/Ladybird}
PROFILE=superawesomemagical

if [ ! -x "$LADYBIRD" ]; then
  echo "SuperAwesomeMagical Browser's Ladybird is missing ($LADYBIRD): reinstall the package." >&2
  exit 1
fi

settings="${XDG_CONFIG_HOME:-$HOME/.config}/Ladybird/Profiles/$PROFILE/Settings.json"
if [ ! -e "$settings" ]; then
  mkdir -p "$(dirname "$settings")"
  # The bookmarks of the Firefox-based SuperAwesomeMagical Browser (2026.11), if there are any.
  firefox="${XDG_DATA_HOME:-$HOME/.local/share}/superawesomemagicalbrowser/profile"
  if [ -d "$firefox" ] && command -v python3 > /dev/null; then
    python3 -I "$SHARE/firefox-bookmarks.py" "$firefox" "$(dirname "$settings")/Bookmarks.json" || true
  fi
  sed "s|@SHARE@|$SHARE|g" "$SHARE/settings.json" > "$settings.new" && mv "$settings.new" "$settings"
fi

# Lexend for the interface and for pages that want a plain sans-serif (desktop/edition/fonts.conf).
export FONTCONFIG_FILE="$SHARE/fonts.conf"

exec "$LADYBIRD" --profile "$PROFILE" "$@"
