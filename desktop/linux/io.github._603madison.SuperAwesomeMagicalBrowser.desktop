[Desktop Entry]
Type=Application
Version=1.5
Name=SuperAwesomeMagical Browser
GenericName=Web Browser
Comment=Browse the web, with your tabs down the side
Keywords=Internet;WWW;Browser;Web;Explorer;Firefox;
Exec=superawesomemagicalbrowser %u
Icon=io.github._603madison.SuperAwesomeMagicalBrowser
Terminal=false
Categories=GNOME;GTK;Network;WebBrowser;
MimeType=text/html;text/xml;application/xhtml+xml;application/xml;application/rss+xml;application/rdf+xml;image/gif;image/jpeg;image/png;image/svg+xml;image/webp;image/avif;video/webm;application/x-xpinstall;application/pdf;x-scheme-handler/http;x-scheme-handler/https;
StartupNotify=true
StartupWMClass=io.github._603madison.SuperAwesomeMagicalBrowser
Actions=new-window;new-private-window;

[Desktop Action new-window]
Name=New Window
Exec=superawesomemagicalbrowser --new-window %u

[Desktop Action new-private-window]
Name=New Private Window
Exec=superawesomemagicalbrowser --private-window %u
