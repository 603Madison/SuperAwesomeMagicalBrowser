[Desktop Entry]
Type=Application
Version=1.5
Name=SuperAwesomeMagical Browser
GenericName=Web Browser
Comment=Ladybird in the SuperAwesomeMagical look, with your tabs down the side
Keywords=Internet;WWW;Browser;Web;Ladybird;
Exec=superawesomemagicalbrowser %U
Icon=io.github._603madison.SuperAwesomeMagicalBrowser
Terminal=false
Categories=Network;WebBrowser;
MimeType=text/html;application/xhtml+xml;x-scheme-handler/http;x-scheme-handler/https;
StartupNotify=true
StartupWMClass=org.ladybird.Ladybird
Actions=new-window;

[Desktop Action new-window]
Name=New Window
Exec=superawesomemagicalbrowser --new-window
