# What a build of SuperAwesomeMagical Browser for Linux is made of: Ladybird, built by us with our patches
# (desktop/ladybird), Bitwarden's command-line client, and our part (the presets, the start page, the
# launcher). VERSION is a date, so it sorts after the Firefox-based 160.0 and 161.0; the Linux workflow
# raises it when it follows a new Ladybird release. Raise RELEASE for another release on the same day.
VERSION=2026.11.27
RELEASE=1

# The Ladybird release we build, with our patches (desktop/ladybird). 2026.48.0 is the first with every published
# security advisory fixed (GHSA-3v9p-556w-v6vp, the WebGL one, was still open in 2026.47.x).
LADYBIRD_VERSION=2026.48.0

# Bitwarden's command-line client, which the browser's Bitwarden button works through: the "oss" build (GPL-3.0
# only) from github.com/bitwarden/clients (tag cli-v<version>), checked against the digest GitHub publishes for it.
BITWARDEN_CLI_VERSION=2026.11.1

# Lexend, the family's typeface (google/fonts, as SuperAwesomeMagicalLinux pins it).
LEXEND_REV=c30b221beb0c1da59d563feb91ec8656a1fa972a
LEXEND_SHA256=3add53e641fbc81da64da4bb254285e2831b52b029527bc0714e2b9610832ee6
