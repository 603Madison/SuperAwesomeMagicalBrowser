# What a build of SuperAwesomeMagical Browser for Linux is made of. The browser is Ladybird, from
# Ladybird's own repositories, which keep it up to date; this is the version of our part (the
# presets, the start page, the launcher), dated, so it sorts after the Firefox-based 160.0 and 161.0.
# Raise RELEASE for another release on the same day.
VERSION=2026.11.27
RELEASE=1

# The Ladybird release we build, with our patches (desktop/ladybird). 2026.48.0 is the first with every published
# security advisory fixed (GHSA-3v9p-556w-v6vp, the WebGL one, was still open in 2026.47.x).
LADYBIRD_VERSION=2026.48.0
# Until the packages carry our own build: the oldest Ladybird they accept.
LADYBIRD_MIN_VERSION=2026.48.0

# Lexend, the family's typeface (google/fonts, as SuperAwesomeMagicalLinux pins it).
LEXEND_REV=c30b221beb0c1da59d563feb91ec8656a1fa972a
LEXEND_SHA256=3add53e641fbc81da64da4bb254285e2831b52b029527bc0714e2b9610832ee6
