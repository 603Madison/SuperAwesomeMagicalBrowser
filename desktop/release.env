# What a build of SuperAwesomeMagical Browser is made of, for Linux and Android. The Linux
# workflow bumps FIREFOX_VERSION and GECKOVIEW_VERSION (and resets RELEASE to 1) when Mozilla ships
# a new Firefox; raise RELEASE yourself when only our own files changed. The version of the
# packages and the app is FIREFOX_VERSION-RELEASE.

# Firefox, from Mozilla's release archive, checked against its GPG-signed SHA256SUMS.
FIREFOX_VERSION=160.0
RELEASE=1
# The same Firefox for Android (GeckoView, from maven.mozilla.org): <version>.<build ID>.
GECKOVIEW_VERSION=160.0.20261104181552

# Mozilla's release signing key (primary key; signing subkeys rotate under it).
MOZILLA_KEY_FPR=14F26682D0916CDD81E37B6D61B7B526D98F0353

# Lexend, the family's typeface (google/fonts, as SuperAwesomeMagicalLinux pins it).
LEXEND_REV=c30b221beb0c1da59d563feb91ec8656a1fa972a
LEXEND_SHA256=3add53e641fbc81da64da4bb254285e2831b52b029527bc0714e2b9610832ee6
