+BitwardenClient::BitwardenClient()
+{
+    m_lock_timer.setSingleShot(true);
+    m_lock_timer.setInterval(LOCK_AFTER_MS);
+    QObject::connect(&m_lock_timer, &QTimer::timeout, this, [this] { lock(); });
+}
+
+QString BitwardenClient::program() const
+{
+    if (auto configured = qEnvironmentVariable("SAMB_BITWARDEN_CLI"); !configured.isEmpty())
+        return configured;
+    if (QFileInfo(BUNDLED_CLI).isExecutable())
+        return BUNDLED_CLI;
+    return QStandardPaths::findExecutable("bw");
+}
+
+void BitwardenClient::run(QStringList arguments, Environment extra, Function<void(Result)> callback)
+{
+    auto program = this->program();
+    if (program.isEmpty()) {
+        callback({ .ok = false, .output = {}, .error = "missing" });
+        return;
+    }
+
+    auto environment = QProcessEnvironment::systemEnvironment();
+    environment.remove("BW_SESSION");
+    environment.remove("BW_CLIENTID");
+    environment.remove("BW_CLIENTSECRET");
+    // The browser's sign-in is its own, apart from any bw the person uses themselves.
+    auto data_directory = QStandardPaths::writableLocation(QStandardPaths::GenericDataLocation) + "/superawesomemagicalbrowser/bitwarden";
+    QDir().mkpath(data_directory);
+    QFile::setPermissions(data_directory, QFileDevice::ReadOwner | QFileDevice::WriteOwner | QFileDevice::ExeOwner);
+    environment.insert("BITWARDENCLI_APPDATA_DIR", data_directory);
+    environment.insert("BW_NOINTERACTION", "true");
+    if (!m_session.isEmpty())
+        environment.insert("BW_SESSION", QString::fromLatin1(m_session));
+    for (auto it = extra.cbegin(); it != extra.cend(); ++it)
+        environment.insert(it.key(), it.value());
+
+    auto* job = new BitwardenJob(this);
+    job->setProcessEnvironment(environment);
+    job->setProgram(program);
+    arguments.append("--nointeraction");
+    job->setArguments(arguments);
+    job->on_done = [job, callback = AK::move(callback)](int exit_code, bool ran) {
+        Result result;
+        result.output = QString::fromUtf8(job->readAllStandardOutput());
+        auto error_output = QString::fromUtf8(job->readAllStandardError());
+        result.ok = ran && exit_code == 0;
+        if (!ran)
+            result.error = "Bitwarden's command-line client didn't start.";
+        else if (!result.ok)
+            result.error = first_line(error_output.isEmpty() ? result.output : error_output);
+        callback(AK::move(result));
+    };
+    QObject::connect(job, &QProcess::finished, job, [job](int exit_code, QProcess::ExitStatus status) {
+        job->finish(status == QProcess::NormalExit ? exit_code : -1, true);
+    });
+    QObject::connect(job, &QProcess::errorOccurred, job, [job](QProcess::ProcessError error) {
+        if (error == QProcess::FailedToStart)
+            job->finish(-1, false);
+    });
+    QTimer::singleShot(COMMAND_TIMEOUT_MS, job, [job] {
+        job->kill();
+    });
+    job->start(QIODevice::ReadOnly);
+}
