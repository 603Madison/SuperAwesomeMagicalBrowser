+// One run of bw, which hands its result to the callback once and then goes.
+class BitwardenJob final : public QProcess {
+public:
+    AK_ALLOC_WITH_KMALLOC;
+
+    explicit BitwardenJob(QObject* parent)
+        : QProcess(parent)
+    {
+    }
+
+    Function<void(int exit_code, bool ran)> on_done;
+
+    void finish(int exit_code, bool ran)
+    {
+        if (m_finished)
+            return;
+        m_finished = true;
+        if (on_done)
+            on_done(exit_code, ran);
+        deleteLater();
+    }
+
+private:
+    bool m_finished { false };
+};
+
+}
