+void BitwardenClient::set_session(QByteArray session)
+{
+    m_session.fill('\0');
+    m_session = AK::move(session);
+    if (m_session.isEmpty())
+        m_lock_timer.stop();
+    else
+        touch();
+}
+
+void BitwardenClient::touch()
+{
+    if (!m_session.isEmpty())
+        m_lock_timer.start();
+}
+
+void BitwardenClient::status(Function<void(Status, QString)> callback)
+{
+    run({ "status" }, {}, [this, callback = AK::move(callback)](Result result) {
+        if (result.error == "missing") {
+            callback(Status::Missing, {});
+            return;
+        }
+        if (!result.ok) {
+            callback(Status::Failed, result.error);
+            return;
+        }
+        auto status = QJsonDocument::fromJson(result.output.toUtf8()).object();
+        m_email = status.value("userEmail").toString();
+        m_server = status.value("serverUrl").toString();
+        auto state = status.value("status").toString();
+        if (state == "unlocked" && !m_session.isEmpty()) {
+            callback(Status::Unlocked, {});
+        } else if (state == "unauthenticated") {
+            set_session({});
+            callback(Status::SignedOut, {});
+        } else {
+            set_session({});
+            callback(Status::Locked, {});
+        }
+    });
+}
+
+static QString server_url(QString const& server)
+{
+    if (server == "eu")
+        return "https://vault.bitwarden.eu";
+    if (server.isEmpty() || server == "us")
+        return "https://vault.bitwarden.com";
+    return server.contains("://") ? server : "https://" + server;
+}
