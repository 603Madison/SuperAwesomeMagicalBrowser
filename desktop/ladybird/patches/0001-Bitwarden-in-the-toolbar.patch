+void PasswordPopover::show_sign_in(QString const& error)
+{
+    auto& layout = new_body("Sign in to Bitwarden");
+    if (!error.isEmpty())
+        add_label(layout, error, "LadybirdBookmarkPopoverLabel");
+
+    auto* server = new QComboBox(m_body);
+    server->setObjectName("LadybirdBookmarkPopoverFolder");
+    server->setAccessibleName("Server");
+    server->addItem("bitwarden.com", "us");
+    server->addItem("bitwarden.eu", "eu");
+    server->addItem("Self-hosted", "self");
+    layout.addWidget(server);
+    auto* server_address = new_field(m_body, "Server address (https://…)", false);
+    server_address->hide();
+    layout.addWidget(server_address);
+    QObject::connect(server, &QComboBox::currentIndexChanged, this, [this, server, server_address] {
+        server_address->setVisible(server->currentData().toString() == "self");
+        if (on_resize_needed)
+            on_resize_needed();
+    });
+
+    auto* method = new QComboBox(m_body);
+    method->setObjectName("LadybirdBookmarkPopoverFolder");
+    method->setAccessibleName("Sign in with");
+    method->addItem("Email and master password", "password");
+    method->addItem("API key and master password", "apikey");
+    layout.addWidget(method);
+
+    auto* email = new_field(m_body, "Email address", false);
+    auto* client_id = new_field(m_body, "API key client_id", false);
+    auto* client_secret = new_field(m_body, "API key client_secret", true);
+    auto* password = new_field(m_body, "Master password", true);
+    auto* code_row = new QWidget(m_body);
+    auto* code_layout = new QHBoxLayout(code_row);
+    code_layout->setContentsMargins(0, 0, 0, 0);
+    code_layout->setSpacing(6);
+    auto* code = new_field(code_row, "Two-step code, if you use one", false);
+    auto* code_method = new QComboBox(code_row);
+    code_method->setObjectName("LadybirdBookmarkPopoverFolder");
+    code_method->setAccessibleName("Two-step login with");
+    code_method->addItem("App", 0);
+    code_method->addItem("Email", 1);
+    code_method->addItem("YubiKey", 3);
+    code_layout->addWidget(code, 1);
+    code_layout->addWidget(code_method);
+    layout.addWidget(email);
+    layout.addWidget(client_id);
+    layout.addWidget(client_secret);
+    layout.addWidget(password);
+    layout.addWidget(code_row);
+    client_id->hide();
+    client_secret->hide();
+    QObject::connect(method, &QComboBox::currentIndexChanged, this, [this, method, email, client_id, client_secret, code_row] {
+        auto with_key = method->currentData().toString() == "apikey";
+        email->setVisible(!with_key);
+        code_row->setVisible(!with_key);
+        client_id->setVisible(with_key);
+        client_secret->setVisible(with_key);
+        if (on_resize_needed)
+            on_resize_needed();
+    });
+
+    auto* note = add_label(layout, "Your vault stays in Bitwarden. The browser keeps it unlocked only while it's open, for 30 minutes after you last use it.", "LadybirdBookmarkPopoverLabel");
+    note->setEnabled(false);
+
+    auto* row = new QHBoxLayout;
+    row->addStretch(1);
+    auto* sign_in = new_button(m_body, "Sign in", true);
+    row->addWidget(sign_in);
+    layout.addLayout(row);
+
+    auto submit = [this, server, server_address, method, email, client_id, client_secret, password, code, code_method, sign_in] {
+        auto server_value = server->currentData().toString() == "self" ? server_address->text().trimmed() : server->currentData().toString();
+        auto secret = password->text();
+        password->clear();
+        sign_in->setEnabled(false);
+        sign_in->setText("Signing in…");
+        auto generation = m_generation;
+        auto done = [this, popover = QPointer(this), generation](QString error) {
+            if (!popover || generation != m_generation)
+                return;
+            if (!error.isEmpty())
+                show_sign_in(error);
+            else
+                look_up();
+        };
+        if (method->currentData().toString() == "apikey") {
+            auto key_secret = client_secret->text();
+            client_secret->clear();
+            BitwardenClient::the().sign_in_with_api_key(server_value, client_id->text(), key_secret, secret, AK::move(done));
+        } else {
+            BitwardenClient::the().sign_in(server_value, email->text().trimmed(), secret, code->text(), code_method->currentData().toInt(), AK::move(done));
+        }
+    };
+    QObject::connect(sign_in, &QPushButton::clicked, this, submit);
+    QObject::connect(password, &QLineEdit::returnPressed, this, submit);
+    QObject::connect(code, &QLineEdit::returnPressed, this, submit);
+    finish_body();
+    email->setFocus();
+}
+
+void PasswordPopover::show_unlock(QString const& error)
+{
+    auto& client = BitwardenClient::the();
+    auto& layout = new_body("Unlock Bitwarden");
+    add_label(layout, error.isEmpty() ? client.email() : error, "LadybirdBookmarkPopoverLabel");
+    auto* password = new_field(m_body, "Master password", true);
+    layout.addWidget(password);
+
+    auto* row = new QHBoxLayout;
+    row->setSpacing(8);
+    auto* sign_out = new_button(m_body, "Sign out", false);
+    row->addWidget(sign_out);
+    row->addStretch(1);
+    auto* unlock = new_button(m_body, "Unlock", true);
+    row->addWidget(unlock);
+    layout.addLayout(row);
+
+    auto submit = [this, password, unlock] {
+        auto secret = password->text();
+        password->clear();
+        unlock->setEnabled(false);
+        unlock->setText("Unlocking…");
+        auto generation = m_generation;
+        BitwardenClient::the().unlock(secret, [this, popover = QPointer(this), generation](QString error) {
+            if (!popover || generation != m_generation)
+                return;
+            if (!error.isEmpty())
+                show_unlock(error);
+            else
+                look_up();
+        });
+    };
+    QObject::connect(unlock, &QPushButton::clicked, this, submit);
+    QObject::connect(password, &QLineEdit::returnPressed, this, submit);
+    QObject::connect(sign_out, &QPushButton::clicked, this, [this] {
+        BitwardenClient::the().sign_out([this, popover = QPointer(this)] {
+            if (popover)
+                show_sign_in();
+        });
+    });
+    finish_body();
+    password->setFocus();
+}
+
+void PasswordPopover::look_up()
+{
+    auto& layout = new_body("Bitwarden");
+    add_label(layout, "Looking for logins…", "LadybirdBookmarkPopoverLabel");
+    finish_body();
+    auto generation = m_generation;
+    BitwardenClient::the().logins_for(m_url, [this, popover = QPointer(this), generation](QList<BitwardenLogin> logins, QString error) {
+        if (!popover || generation != m_generation)
+            return;
+        if (!error.isEmpty()) {
+            if (!BitwardenClient::the().is_unlocked())
+                show_unlock();
+            else
+                show_message("Bitwarden", error);
+            return;
+        }
+        // The shortcut fills the only login there is straight away, as Bitwarden's own does.
+        if (m_trigger == Trigger::Shortcut && logins.size() == 1 && !m_insecure) {
+            fill(logins.first());
+            return;
+        }
+        show_logins(logins);
+    });
+}
+
+void PasswordPopover::show_logins(QList<BitwardenLogin> const& logins)
+{
+    auto host = QUrl(m_url).host();
+    auto& layout = new_body(logins.isEmpty() ? "No logins for " + host : "Fill in a login");
+    if (m_insecure)
+        add_label(layout, "This page isn't secure: what you fill in can be read on its way.", "LadybirdBookmarkPopoverLabel");
+    if (logins.isEmpty())
+        add_label(layout, "Your Bitwarden vault has none for this site.", "LadybirdBookmarkPopoverLabel");
+
+    for (auto const& login : logins) {
+        auto text = login.name;
+        if (!login.username.isEmpty())
+            text += " · " + login.username;
+        auto* button = new_button(m_body, text, false);
+        button->setToolTip(text);
+        button->setStyleSheet("text-align: left;");
+        QObject::connect(button, &QPushButton::clicked, this, [this, login] { fill(login); });
+        layout.addWidget(button);
+    }
+
+    auto* row = new QHBoxLayout;
+    row->setSpacing(8);
+    auto* lock = new_button(m_body, "Lock", false);
+    QObject::connect(lock, &QPushButton::clicked, this, [this] {
+        BitwardenClient::the().lock();
+        close();
+    });
+    row->addWidget(lock);
+    auto* vault = new_button(m_body, "Open vault", false);
+    QObject::connect(vault, &QPushButton::clicked, this, [this] {
+        auto server = BitwardenClient::the().server();
+        if (on_open_url)
+            on_open_url(server.isEmpty() ? QString("https://vault.bitwarden.com") : server);
+        close();
+    });
+    row->addWidget(vault);
+    row->addStretch(1);
+    auto* done = new_button(m_body, "Done", true);
+    QObject::connect(done, &QPushButton::clicked, this, [this] { close(); });
+    row->addWidget(done);
+    layout.addLayout(row);
+    finish_body();
+}
+
+void PasswordPopover::fill(BitwardenLogin const& login)
+{
+    if (!m_tab) {
+        close();
+        return;
+    }
+    m_tab->view().run_javascript(ak_string_from_qstring(bitwarden_fill_script(m_origin, login.username, login.password)));
+    if (!login.has_totp) {
+        close();
+        return;
+    }
+    // As Bitwarden's own does: the login's verification code goes on the clipboard, ready for the next page.
+    auto& layout = new_body("Filled in");
+    add_label(layout, "Copying the verification code…", "LadybirdBookmarkPopoverLabel");
+    finish_body();
+    auto generation = m_generation;
+    BitwardenClient::the().totp(login.id, [this, popover = QPointer(this), generation](QString code) {
+        if (!popover || generation != m_generation)
+            return;
+        if (!code.isEmpty())
+            QApplication::clipboard()->setText(code);
+        show_message("Filled in", code.isEmpty() ? "The verification code couldn't be copied." : "The verification code is copied, ready to paste.");
+        QTimer::singleShot(2500, this, [this, popover = QPointer(this), generation = m_generation] {
+            if (popover && generation == m_generation)
+                close();
+        });
+    });
+}
+
+}
