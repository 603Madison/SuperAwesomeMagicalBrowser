+void PasswordPopover::start(Tab& tab, Trigger trigger)
+{
+    m_tab = &tab;
+    m_trigger = trigger;
+    auto url = tab.url();
+    m_url = qstring_from_ak_string(url.serialize());
+    m_origin = qstring_from_ak_string(url.origin().serialize());
+    auto scheme = qstring_from_ak_string(url.scheme());
+    auto host = QUrl(m_url).host();
+    m_insecure = scheme == "http" && host != "localhost" && host != "127.0.0.1" && host != "::1" && !host.endsWith(".localhost");
+
+    if ((scheme != "https" && scheme != "http") || m_origin == "null") {
+        show_message("Bitwarden", "Bitwarden fills in logins on web pages.");
+        return;
+    }
+
+    auto& layout = new_body("Bitwarden");
+    add_label(layout, "Opening your vault…", "LadybirdBookmarkPopoverLabel");
+    finish_body();
+
+    auto generation = m_generation;
+    BitwardenClient::the().status([this, popover = QPointer(this), generation](BitwardenClient::Status status, QString error) {
+        if (!popover || generation != m_generation)
+            return;
+        switch (status) {
+        case BitwardenClient::Status::Missing:
+            show_message("Bitwarden", "Bitwarden's command-line client isn't installed (the bw command).");
+            break;
+        case BitwardenClient::Status::Failed:
+            show_message("Bitwarden", "Bitwarden didn't answer: " + error);
+            break;
+        case BitwardenClient::Status::SignedOut:
+            show_sign_in();
+            break;
+        case BitwardenClient::Status::Locked:
+            show_unlock();
+            break;
+        case BitwardenClient::Status::Unlocked:
+            look_up();
+            break;
+        }
+    });
+}
+
+void PasswordPopover::show_message(QString const& title, QString const& message)
+{
+    auto& layout = new_body(title);
+    add_label(layout, message, "LadybirdBookmarkPopoverLabel");
+    auto* row = new QHBoxLayout;
+    row->addStretch(1);
+    auto* done = new_button(m_body, "Done", true);
+    QObject::connect(done, &QPushButton::clicked, this, [this] { close(); });
+    row->addWidget(done);
+    layout.addLayout(row);
+    finish_body();
+    done->setFocus();
+}
