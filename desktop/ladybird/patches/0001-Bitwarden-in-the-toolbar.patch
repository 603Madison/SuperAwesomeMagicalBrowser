+void BitwardenClient::sign_in(QString server, QString email, QString password, QString code, int method, Function<void(QString)> callback)
+{
+    set_session({});
+    run({ "logout" }, {}, [this, server = AK::move(server), email = AK::move(email), password = AK::move(password), code = AK::move(code), method, callback = AK::move(callback)](Result) mutable {
+        run({ "config", "server", server_url(server) }, {}, [this, email = AK::move(email), password = AK::move(password), code = AK::move(code), method, callback = AK::move(callback)](Result result) mutable {
+            if (!result.ok) {
+                callback(result.error);
+                return;
+            }
+            QStringList arguments { "login", email, "--passwordenv", "SAMB_BW_PASSWORD", "--raw" };
+            if (!code.trimmed().isEmpty())
+                arguments << "--method" << QString::number(method) << "--code" << code.trimmed();
+            run(arguments, { { "SAMB_BW_PASSWORD", password } }, [this, callback = AK::move(callback)](Result result) {
+                if (!result.ok) {
+                    callback(result.error);
+                    return;
+                }
+                set_session(first_line(result.output).toLatin1());
+                run({ "sync" }, {}, [](Result) { });
+                callback({});
+            });
+        });
+    });
+}
+
+void BitwardenClient::sign_in_with_api_key(QString server, QString client_id, QString client_secret, QString password, Function<void(QString)> callback)
+{
+    set_session({});
+    run({ "logout" }, {}, [this, server = AK::move(server), client_id = AK::move(client_id), client_secret = AK::move(client_secret), password = AK::move(password), callback = AK::move(callback)](Result) mutable {
+        run({ "config", "server", server_url(server) }, {}, [this, client_id = AK::move(client_id), client_secret = AK::move(client_secret), password = AK::move(password), callback = AK::move(callback)](Result result) mutable {
+            if (!result.ok) {
+                callback(result.error);
+                return;
+            }
+            Environment key { { "BW_CLIENTID", client_id.trimmed() }, { "BW_CLIENTSECRET", client_secret.trimmed() } };
+            run({ "login", "--apikey" }, key, [this, password = AK::move(password), callback = AK::move(callback)](Result result) mutable {
+                if (!result.ok) {
+                    callback(result.error);
+                    return;
+                }
+                unlock(AK::move(password), AK::move(callback));
+            });
+        });
+    });
+}
+
+void BitwardenClient::unlock(QString password, Function<void(QString)> callback)
+{
+    run({ "unlock", "--passwordenv", "SAMB_BW_PASSWORD", "--raw" }, { { "SAMB_BW_PASSWORD", password } }, [this, callback = AK::move(callback)](Result result) {
+        if (!result.ok) {
+            callback(result.error);
+            return;
+        }
+        set_session(first_line(result.output).toLatin1());
+        // The vault on disk is as of the last sync; bring it up to date for next time.
+        run({ "sync" }, {}, [](Result) { });
+        callback({});
+    });
+}
+
+void BitwardenClient::logins_for(QString url, Function<void(QList<BitwardenLogin>, QString)> callback)
+{
+    touch();
+    run({ "list", "items", "--url", url }, {}, [callback = AK::move(callback)](Result result) {
+        if (!result.ok) {
+            callback({}, result.error);
+            return;
+        }
+        QList<BitwardenLogin> logins;
+        for (auto const& value : QJsonDocument::fromJson(result.output.toUtf8()).array()) {
+            auto item = value.toObject();
+            // Type 1 is a login; cards, identities and notes have nothing to fill here.
+            if (item.value("type").toInt() != 1)
+                continue;
+            auto login = item.value("login").toObject();
+            logins.append({
+                .id = item.value("id").toString(),
+                .name = item.value("name").toString(),
+                .username = login.value("username").toString(),
+                .password = login.value("password").toString(),
+                .has_totp = !login.value("totp").toString().isEmpty(),
+            });
+        }
+        callback(AK::move(logins), {});
+    });
+}
+
+void BitwardenClient::totp(QString id, Function<void(QString)> callback)
+{
+    run({ "get", "totp", id }, {}, [callback = AK::move(callback)](Result result) {
+        callback(result.ok ? first_line(result.output) : QString {});
+    });
+}
+
+void BitwardenClient::lock()
+{
+    if (m_session.isEmpty())
+        return;
+    run({ "lock" }, {}, [](Result) { });
+    set_session({});
+}
+
+void BitwardenClient::sign_out(Function<void()> callback)
+{
+    set_session({});
+    run({ "logout" }, {}, [callback = AK::move(callback)](Result) { callback(); });
+}
