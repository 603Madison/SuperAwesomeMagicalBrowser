+QVBoxLayout& PasswordPopover::new_body(QString const& title)
+{
+    ++m_generation;
+    if (m_body) {
+        m_body->hide();
+        m_body->deleteLater();
+    }
+    m_body = new QWidget(&card());
+    auto* layout = new QVBoxLayout(m_body);
+    layout->setContentsMargins(0, 0, 0, 0);
+    layout->setSpacing(10);
+    add_label(*layout, title, "LadybirdBookmarkPopoverTitle");
+    card().layout()->addWidget(m_body);
+    return *layout;
+}
