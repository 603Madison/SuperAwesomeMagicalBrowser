+static QPushButton* new_button(QWidget* parent, QString const& text, bool primary)
+{
+    auto* button = new QPushButton(text, parent);
+    button->setObjectName(primary ? "LadybirdBookmarkPopoverDone" : "LadybirdBookmarkPopoverRemove");
+    button->setAttribute(Qt::WA_LayoutUsesWidgetRect);
+    if (primary)
+        button->setDefault(true);
+    return button;
+}
