+// Where the packages put Bitwarden's command-line client; SAMB_BITWARDEN_CLI points elsewhere, and failing both, bw
+// is looked for on the PATH.
+static constexpr auto BUNDLED_CLI = "/usr/lib/superawesomemagicalbrowser/bitwarden/bw";
