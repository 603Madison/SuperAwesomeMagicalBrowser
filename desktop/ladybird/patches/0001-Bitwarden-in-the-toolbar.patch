+QString bitwarden_fill_script(QString const& origin, QString const& username, QString const& password)
+{
+    // NB: The values go in as JSON, which is also JavaScript, so nothing in them can end the string they're in.
+    auto values = QString::fromUtf8(QJsonDocument(QJsonArray { origin, username, password }).toJson(QJsonDocument::Compact));
+    return QStringLiteral(R"js((() => {
+    const [origin, username, password] = %1;
+    // The page may have gone elsewhere since the login was looked up.
+    if (location.origin !== origin)
+        return;
+    const usable = field => {
+        if (field.disabled || field.readOnly)
+            return false;
+        const box = field.getBoundingClientRect();
+        const style = getComputedStyle(field);
+        return box.width > 0 && box.height > 0 && style.visibility !== "hidden" && style.display !== "none";
+    };
+    const valueSetter = Object.getOwnPropertyDescriptor(HTMLInputElement.prototype, "value").set;
+    const put = (field, value) => {
+        if (!value)
+            return;
+        field.focus();
+        valueSetter.call(field, value);
+        field.dispatchEvent(new Event("input", { bubbles: true }));
+        field.dispatchEvent(new Event("change", { bubbles: true }));
+    };
+    const isUsername = field => ["text", "email", "tel", ""].includes(field.type) || field.autocomplete === "username";
+    const fields = [...document.querySelectorAll("input")].filter(usable);
+    const passwords = fields.filter(field => field.type === "password");
+    const passwordField = passwords.find(field => field === document.activeElement) ?? passwords[0];
+    let usernameField = null;
+    if (passwordField) {
+        const scope = passwordField.form ? [...passwordField.form.elements].filter(field => field.tagName === "INPUT" && usable(field)) : fields;
+        const before = scope.slice(0, scope.indexOf(passwordField)).filter(isUsername);
+        usernameField = scope.find(field => field.autocomplete === "username" && field !== passwordField) ?? before.at(-1) ?? null;
+    } else {
+        // A sign-in that asks for the username first, on a page of its own.
+        usernameField = fields.find(field => field === document.activeElement && isUsername(field))
+            ?? fields.find(field => field.autocomplete === "username") ?? fields.find(isUsername) ?? null;
+    }
+    if (usernameField)
+        put(usernameField, username);
+    if (passwordField)
+        put(passwordField, password);
+})();)js")
+        .arg(values);
+}
