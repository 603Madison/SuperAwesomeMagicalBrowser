+
+void WindowToolbar::show_password_popover(bool from_shortcut)
+{
+    if (!m_tab)
+        return;
+    if (!m_password_popover) {
+        m_password_popover = new PasswordPopover(this);
+        m_password_popover->on_visibility_change = [this](bool visible) {
+            m_passwords_button->setChecked(visible);
+        };
+        m_password_popover->on_resize_needed = [this] {
+            if (m_password_popover && m_password_popover->isVisible())
+                fit_password_popover();
+        };
+        m_password_popover->on_open_url = [this](QString url) {
+            browser_window().new_tab_from_url(URL::Parser::basic_parse(ak_string_from_qstring(url)).value_or(URL::URL::about("blank"sv)), Web::HTML::ActivateTab::Yes, BrowserWindow::TabLocation::after_current_tab());
+        };
+    }
+    m_password_popover->update_chrome_style(palette());
+    m_password_popover->show();
+    m_password_popover->start(*m_tab, from_shortcut ? PasswordPopover::Trigger::Shortcut : PasswordPopover::Trigger::Button);
+    fit_password_popover();
+    m_password_popover->raise();
+}
