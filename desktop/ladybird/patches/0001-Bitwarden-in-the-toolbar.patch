+static QLineEdit* new_field(QWidget* parent, QString const& placeholder, bool secret)
+{
+    auto* field = new QLineEdit(parent);
+    field->setObjectName("LadybirdBookmarkPopoverName");
+    field->setAttribute(Qt::WA_MacShowFocusRect, false);
+    field->setPlaceholderText(placeholder);
+    field->setAccessibleName(placeholder);
+    if (secret)
+        field->setEchoMode(QLineEdit::Password);
+    return field;
+}
