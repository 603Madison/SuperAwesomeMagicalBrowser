@@ -0,0 +1,135 @@
+/*
+ * Copyright (c) 2026, SuperAwesomeMagical Browser
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+// SuperAwesomeMagical Browser: Bitwarden in the toolbar. The vault is reached through Bitwarden's own command-line
+// client (bw), which signs in, keeps the vault encrypted on disk and matches logins to pages by Bitwarden's rules; the
+// key that unlocks it (bw's session key) is only ever held here, in memory, and handed to bw in its environment.
+
+#pragma once
+
+#include <AK/Function.h>
+#include <AK/kmalloc.h>
+#include <UI/Qt/Popover.h>
+
+#include <QByteArray>
+#include <QList>
+#include <QMap>
+#include <QObject>
+#include <QPointer>
+#include <QProcess>
+#include <QString>
+#include <QStringList>
+#include <QTimer>
+
+class QLabel;
+class QPalette;
+class QVBoxLayout;
+
+namespace Ladybird {
+
+class Tab;
+
+struct BitwardenLogin {
+    QString id;
+    QString name;
+    QString username;
+    QString password;
+    bool has_totp { false };
+};
+
+class BitwardenClient final : public QObject {
+public:
+    AK_ALLOC_WITH_KMALLOC;
+
+    enum class Status {
+        Missing,
+        SignedOut,
+        Locked,
+        Unlocked,
+        Failed,
+    };
+
+    static BitwardenClient& the();
+
+    bool is_unlocked() const { return !m_session.isEmpty(); }
+    QString const& email() const { return m_email; }
+    QString const& server() const { return m_server; }
+
+    void status(Function<void(Status, QString error)>);
+    void sign_in(QString server, QString email, QString password, QString code, int method, Function<void(QString error)>);
+    void sign_in_with_api_key(QString server, QString client_id, QString client_secret, QString password, Function<void(QString error)>);
+    void unlock(QString password, Function<void(QString error)>);
+    void logins_for(QString url, Function<void(QList<BitwardenLogin>, QString error)>);
+    void totp(QString id, Function<void(QString code)>);
+    void lock();
+    void sign_out(Function<void()>);
+
+    // Every use keeps the vault open for this much longer; then it locks.
+    static constexpr int LOCK_AFTER_MS = 30 * 60 * 1000;
+
+private:
+    struct Result {
+        bool ok { false };
+        QString output;
+        QString error;
+    };
+    using Environment = QMap<QString, QString>;
+
+    BitwardenClient();
+    QString program() const;
+    void run(QStringList arguments, Environment, Function<void(Result)>);
+    void set_session(QByteArray);
+    void touch();
+
+    QByteArray m_session;
+    QString m_email;
+    QString m_server;
+    QTimer m_lock_timer;
+};
+
+class PasswordPopover final : public Popover {
+public:
+    AK_ALLOC_WITH_KMALLOC;
+
+    enum class Trigger {
+        Button,
+        Shortcut,
+    };
+
+    explicit PasswordPopover(QWidget* parent);
+
+    // Looks for the logins of the tab's page, asking to sign in or unlock first when Bitwarden needs it.
+    void start(Tab&, Trigger);
+    void update_chrome_style(QPalette const&);
+
+    Function<void(QString url)> on_open_url;
+    // The popover's contents changed size, so it needs fitting again under its button.
+    Function<void()> on_resize_needed;
+
+private:
+    QVBoxLayout& new_body(QString const& title);
+    void finish_body();
+    void show_message(QString const& title, QString const& message);
+    void show_sign_in(QString const& error = {});
+    void show_unlock(QString const& error = {});
+    void show_logins(QList<BitwardenLogin> const&);
+    void look_up();
+    void fill(BitwardenLogin const&);
+    QLabel* add_label(QVBoxLayout&, QString const&, char const* object_name);
+
+    QPointer<Tab> m_tab;
+    QString m_url;
+    QString m_origin;
+    bool m_insecure { false };
+    Trigger m_trigger { Trigger::Button };
+    QWidget* m_body { nullptr };
+    int m_generation { 0 };
+};
+
+// The script that fills a login into the page, which does nothing unless the page is still at the given origin.
+QString bitwarden_fill_script(QString const& origin, QString const& username, QString const& password);
+
+}
