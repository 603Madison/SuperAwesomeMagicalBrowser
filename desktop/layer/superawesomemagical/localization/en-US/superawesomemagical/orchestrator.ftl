# SuperAwesomeMagical Browser: what "Send to device" says afterwards (Firefox's confirmation hint
# takes its words from Fluent). $device is the device's name as the person gave it.

sam-orchestrator-sent = Sent to { $device }
sam-orchestrator-sent-away = { $device } is away
sam-orchestrator-sent-away-description = It'll open there when it's back.
sam-orchestrator-not-sent = That didn't reach { $device }
sam-orchestrator-not-sent-description = Check this computer is still signed in to your devices, then try again.
