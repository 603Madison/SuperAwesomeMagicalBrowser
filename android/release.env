# What a build of SuperAwesomeMagical Browser for Android is made of. Ladybird has no Android version,
# so the app is on GeckoView (Firefox's engine for Android). The Android workflow follows GeckoView
# releases on its own: it raises FIREFOX_VERSION and GECKOVIEW_VERSION and resets RELEASE to 1.
# Raise RELEASE yourself when only the app changed. The app's version is FIREFOX_VERSION-RELEASE.
FIREFOX_VERSION=161.0
RELEASE=1
# GeckoView from maven.mozilla.org: <Firefox version>.<build ID>.
GECKOVIEW_VERSION=161.0.20261118180411
